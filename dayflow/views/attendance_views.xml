<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Attendance Inherited Tree View -->
    <record id="view_attendance_tree_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.attendance.tree.inherit.dayflow</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="dayflow_status" widget="badge"
                       decoration-success="dayflow_status == 'present'"
                       decoration-danger="dayflow_status == 'absent'"
                       decoration-warning="dayflow_status in ('half_day', 'leave')"/>
                <field name="extra_hours"/>
            </xpath>
        </field>
    </record>

    <!-- Attendance Inherited Form View -->
    <record id="view_attendance_form_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.dayflow</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="dayflow_status"/>
                <field name="extra_hours"/>
                <field name="remarks" placeholder="Notes, reasons for late check-in or early departure..."/>
            </xpath>
        </field>
    </record>

    <!-- Attendance Inherited Search View -->
    <record id="hr_attendance_view_filter_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.attendance.view.filter.inherit.dayflow</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="dayflow_present" string="Present"
                        domain="[('dayflow_status', '=', 'present')]"/>
                <filter name="dayflow_absent" string="Absent"
                        domain="[('dayflow_status', '=', 'absent')]"/>
                <filter name="dayflow_half_day" string="Half-day"
                        domain="[('dayflow_status', '=', 'half_day')]"/>
                <filter name="dayflow_leave" string="On Leave"
                        domain="[('dayflow_status', '=', 'leave')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_dayflow_status" string="Dayflow Status"
                            context="{'group_by': 'dayflow_status'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Action: Today's Attendance -->
    <record id="action_dayflow_attendance_today" model="ir.actions.act_window">
        <field name="name">Today's Attendance</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('check_in', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('check_in', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No attendance logs for today yet!
            </p>
        </field>
    </record>
</odoo>
