<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Inherited Form View -->
    <record id="view_employee_form_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.dayflow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_provision_dayflow_user" string="Provision User Account" type="object" class="oe_highlight" groups="dayflow.group_dayflow_admin" attrs="{'invisible': [('user_id', '!=', False)]}"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='category_ids']" position="after">
                <field name="dayflow_role" widget="radio"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Dayflow HRMS" name="dayflow_hrms">
                    <group>
                        <group string="Dayflow Profile Metadata">
                            <field name="dayflow_role"/>
                            <field name="dayflow_joining_date"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group string="Notes &amp; Remarks">
                            <field name="notes" placeholder="Enter general employee profile notes..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Private Information" name="dayflow_private_info">
                            <group>
                                <group string="Personal Identification">
                                    <field name="pan_no"/>
                                    <field name="aadhar_no"/>
                                    <field name="passport_no"/>
                                    <field name="personal_email"/>
                                    <field name="personal_phone"/>
                                </group>
                                <group string="Banking &amp; Payment Details">
                                    <field name="bank_name"/>
                                    <field name="bank_account_no"/>
                                    <field name="ifsc_code"/>
                                </group>
                                <group string="Emergency Contact">
                                    <field name="emergency_contact_name"/>
                                    <field name="emergency_contact_relation"/>
                                    <field name="emergency_contact_phone"/>
                                </group>
                            </group>
                        </page>
                        <page string="Salary &amp; Compensation" name="dayflow_salary_info" groups="dayflow.group_dayflow_admin">
                            <group>
                                <group string="Base Compensation">
                                    <field name="monthly_wage"/>
                                    <field name="salary_structure"/>
                                    <field name="basic_salary"/>
                                    <field name="net_take_home" decoration-success="True" style="font-weight: bold;"/>
                                </group>
                                <group string="Allowances Breakdown">
                                    <field name="hra_allowance"/>
                                    <field name="standard_allowance"/>
                                    <field name="performance_bonus"/>
                                    <field name="lta_allowance"/>
                                </group>
                                <group string="Deductions Breakdown">
                                    <field name="pf_deduction"/>
                                    <field name="pt_deduction"/>
                                </group>
                            </group>
                        </page>
                        <page string="Verification Documents" name="dayflow_documents">
                            <field name="document_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="document_type"/>
                                    <field name="file_name"/>
                                    <field name="upload_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Payroll Records" name="dayflow_payroll" groups="dayflow.group_dayflow_admin">
                            <field name="payroll_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="pay_period"/>
                                    <field name="base_salary"/>
                                    <field name="net_salary"/>
                                    <field name="payroll_status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Employee Inherited Tree View -->
    <record id="view_employee_tree_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.employee.tree.inherit.dayflow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="dayflow_role" widget="badge"
                       decoration-info="dayflow_role == 'employee'"
                       decoration-success="dayflow_role == 'hr'"/>
                <field name="dayflow_joining_date"/>
            </xpath>
        </field>
    </record>

    <!-- Employee Inherited Search View -->
    <record id="view_employee_filter_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.employee.filter.inherit.dayflow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="dayflow_role_employee" string="Role: Employee"
                        domain="[('dayflow_role', '=', 'employee')]"/>
                <filter name="dayflow_role_admin" string="Role: Admin / HR"
                        domain="[('dayflow_role', '=', 'hr')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_dayflow_role" string="Dayflow Role"
                            context="{'group_by': 'dayflow_role'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
