<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Window Actions -->
    <record id="action_dayflow_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Dayflow Employee!
            </p>
        </field>
    </record>

    <record id="action_dayflow_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Track daily employee check-in and check-out logs.
            </p>
        </field>
    </record>

    <record id="action_dayflow_leave" model="ir.actions.act_window">
        <field name="name">Time Off / Leave Requests</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Apply for leave or manage employee leave applications.
            </p>
        </field>
    </record>

    <record id="action_dayflow_payroll" model="ir.actions.act_window">
        <field name="name">Payroll &amp; Salary</field>
        <field name="res_model">dayflow.payroll</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage employee salary structures and payroll records.
            </p>
        </field>
    </record>

    <record id="action_dayflow_document" model="ir.actions.act_window">
        <field name="name">Employee Documents</field>
        <field name="res_model">dayflow.document</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload and manage employee verification documents.
            </p>
        </field>
    </record>

    <!-- Dayflow Root Menu -->
    <menuitem id="menu_dayflow_root"
              name="Dayflow"
              sequence="1"/>

    <!-- Submenus -->
    <menuitem id="menu_dayflow_employee"
              name="Employees"
              parent="menu_dayflow_root"
              action="action_dayflow_employee"
              sequence="10"/>

    <menuitem id="menu_dayflow_attendance"
              name="Attendance"
              parent="menu_dayflow_root"
              action="action_dayflow_attendance"
              sequence="20"/>

    <menuitem id="menu_dayflow_leave"
              name="Time Off"
              parent="menu_dayflow_root"
              action="action_dayflow_leave"
              sequence="30"/>

    <menuitem id="menu_dayflow_payroll"
              name="Payroll"
              parent="menu_dayflow_root"
              action="action_dayflow_payroll"
              sequence="40"/>

    <menuitem id="menu_dayflow_document"
              name="Documents"
              parent="menu_dayflow_root"
              action="action_dayflow_document"
              sequence="50"/>
</odoo>
