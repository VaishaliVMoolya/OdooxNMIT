            <t t-esc="label"/>
            <t t-call="dayflow.landing_icon_arrow"/>
        </a>
    </template>

    <template id="landing_workflow" name="Dayflow Landing Workflow Visual">
        <div class="df-workflow-visual" aria-label="HR data flow">
            <svg class="df-workflow-svg" viewBox="0 0 560 300" aria-hidden="true">
                <defs>
                    <linearGradient id="flowGradient" x1="0" x2="1">
                        <stop stop-color="#9a5cff" stop-opacity=".25"/>
                        <stop offset=".5" stop-color="#b889ff"/>
                        <stop offset="1" stop-color="#d7c2ff" stop-opacity=".55"/>
                    </linearGradient>
                    <filter id="flowGlow">
                        <feGaussianBlur stdDeviation="3" result="blur"/>
                        <feMerge>
                            <feMergeNode in="blur"/>
                            <feMergeNode in="SourceGraphic"/>
                        </feMerge>
                    </filter>
                </defs>
                <path d="M 178 46 C 270 46, 275 150, 386 150 S 450 150, 500 150" pathLength="1"/>
                <path d="M 178 116 C 270 116, 275 150, 386 150 S 450 150, 500 150" pathLength="1"/>
                <path d="M 178 186 C 270 186, 275 150, 386 150 S 450 150, 500 150" pathLength="1"/>
                <path d="M 178 256 C 270 256, 275 150, 386 150 S 450 150, 500 150" pathLength="1"/>
                <circle class="df-flow-dot dot-one" r="3" filter="url(#flowGlow)">
                    <animateMotion dur="7s" repeatCount="indefinite" path="M 178 46 C 270 46, 275 150, 386 150 S 450 150, 500 150"/>
                </circle>
                <circle class="df-flow-dot dot-two" r="3" filter="url(#flowGlow)">
                    <animateMotion dur="7s" begin="1.75s" repeatCount="indefinite" path="M 178 116 C 270 116, 275 150, 386 150 S 450 150, 500 150"/>
                </circle>
                <circle class="df-flow-dot dot-three" r="3" filter="url(#flowGlow)">
                    <animateMotion dur="7s" begin="3.5s" repeatCount="indefinite" path="M 178 186 C 270 186, 275 150, 386 150 S 450 150, 500 150"/>
                </circle>
                <circle class="df-flow-dot dot-four" r="3" filter="url(#flowGlow)">
                    <animateMotion dur="7s" begin="5.25s" repeatCount="indefinite" path="M 178 256 C 270 256, 275 150, 386 150 S 450 150, 500 150"/>
                </circle>
            </svg>
            <div class="df-workflow-nodes">
                <div class="df-node purple">
                    <span><t t-call="dayflow.landing_icon_users"/></span>
                    <div><b>Employees</b><small>Your people</small></div>
                </div>
                <div class="df-node green">
                    <span><t t-call="dayflow.landing_icon_check"/></span>
                    <div><b>Attendance</b><small>Show up</small></div>
                </div>
                <div class="df-node amber">
                    <span><t t-call="dayflow.landing_icon_calendar"/></span>
                    <div><b>Time Off</b><small>Take time</small></div>
                </div>
                <div class="df-node red">
                    <span><t t-call="dayflow.landing_icon_wallet"/></span>
                    <div><b>Payroll</b><small>Get paid</small></div>
                </div>
            </div>
            <div class="df-flow-destination">
                <span>One intelligent flow</span>
                <small>All your HR operations connected in one place. Real-time. Simple. Always in sync.</small>
            </div>
        </div>
    </template>

    <template id="landing_mini_dashboard" name="Dayflow Landing Mini Dashboard">
        <div t-attf-class="df-dashboard #{'df-dashboard-large' if large else ''}">
            <div class="df-dash-top">
                <span class="df-dots">•••</span>
                <span class="df-mini-brand">DF</span>
                <span class="df-dash-title">Dayflow HRMS Management Console</span>
                <span class="df-avatar">JO</span>
            </div>
            <div class="df-metrics">
                <div class="df-metric purple">
                    <t t-call="dayflow.landing_icon_users"/>
                    <strong>8</strong>
                    <small>Total Employees</small>
                </div>
                <div class="df-metric green">
                    <t t-call="dayflow.landing_icon_check"/>
                    <strong>2</strong>
                    <small>Present Today</small>
                </div>
                <div class="df-metric amber">
                    <t t-call="dayflow.landing_icon_calendar"/>
                    <strong>1</strong>
                    <small>On Leave Today</small>
                </div>
                <div class="df-metric red">
                    <t t-call="dayflow.landing_icon_clock"/>
                    <strong>1</strong>
                    <small>Pending Requests</small>
                </div>
            </div>
            <div class="df-dash-grid">
                <div class="df-panel">
                    <h4>Today's Attendance <em>2 Active</em></h4>
                    <div class="df-row"><span>John Doe</span><span>09:00 AM</span><b>Present</b></div>
                    <div class="df-row"><span>Jane Smith</span><span>08:30 AM</span><b>Present</b></div>
                    <a href="#features">View all attendance →</a>
                </div>
                <div class="df-panel">
                    <h4>Pending Leave Request <em class="amber-text">1 Pending</em></h4>
                    <div class="df-request">
                        <b>John Doe</b>
                        <span>Sick Leave<br/><small>Aug 25 - Aug 26 (2d)</small></span>
                        <button type="button">Review</button>
                    </div>
                </div>
            </div>
            <div class="df-dash-grid bottom">
                <div class="df-panel">
                    <h4>Recent Activity</h4>
                    <div class="df-activity"><span class="activity-dot d0"/>John Doe checked in<time>09:00 AM</time></div>
                    <div class="df-activity"><span class="activity-dot d1"/>Leave request received<time>10:15 AM</time></div>
                    <div class="df-activity"><span class="activity-dot d2"/>Payroll updated for August<time>Yesterday</time></div>
                </div>
                <div class="df-panel">
                    <h4>Quick Actions</h4>
                    <div class="df-action"><t t-call="dayflow.landing_icon_sparkles"/>Add Employee</div>
                    <div class="df-action"><t t-call="dayflow.landing_icon_sparkles"/>Mark Attendance</div>
                    <div class="df-action"><t t-call="dayflow.landing_icon_sparkles"/>Review Leave Requests</div>
                    <div class="df-action"><t t-call="dayflow.landing_icon_sparkles"/>Run Payroll</div>
                </div>
            </div>
        </div>
    </template>

