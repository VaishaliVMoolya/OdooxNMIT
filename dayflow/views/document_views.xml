<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dayflow Document Tree View -->
    <record id="view_dayflow_document_tree" model="ir.ui.view">
        <field name="name">dayflow.document.tree</field>
        <field name="model">dayflow.document</field>
        <field name="arch" type="xml">
            <tree string="Employee Documents">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="document_type" widget="badge"/>
                <field name="file_name"/>
                <field name="file_size"/>
                <field name="upload_date"/>
                <field name="expiry_date"/>
                <field name="document_status" widget="badge"
                       decoration-success="document_status == 'verified'"
                       decoration-warning="document_status == 'draft'"
                       decoration-danger="document_status in ('rejected', 'expired')"/>
            </tree>
        </field>
    </record>

    <!-- Dayflow Document Form View -->
    <record id="view_dayflow_document_form" model="ir.ui.view">
        <field name="name">dayflow.document.form</field>
        <field name="model">dayflow.document</field>
        <field name="arch" type="xml">
            <form string="Employee Document">
                <header>
                    <button name="action_verify_document" string="Approve / Verify" type="object" class="btn-success" groups="dayflow.group_dayflow_admin" attrs="{'invisible': [('document_status', '=', 'verified')]}"/>
                    <button name="action_reject_document" string="Reject Document" type="object" class="btn-danger" groups="dayflow.group_dayflow_admin" attrs="{'invisible': [('document_status', '=', 'rejected')]}"/>
                    <field name="document_status" widget="statusbar" statusbar_visible="draft,verified,rejected,expired"/>
                </header>
                <sheet>
                    <group>
                        <group string="Document Information">
                            <field name="name" placeholder="e.g. Employment Contract 2026"/>
                            <field name="employee_id"/>
                            <field name="document_type"/>
                            <field name="upload_date"/>
                        </group>
                        <group string="Validity &amp; Attachment">
                            <field name="document_file" filename="file_name"/>
                            <field name="file_name"/>
                            <field name="file_size"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="verified_by_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes &amp; HR Review">
                        <field name="notes" placeholder="Employee description or notes..."/>
                        <field name="admin_comments" placeholder="HR / Admin decision notes or review comments..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dayflow Document Search View -->
    <record id="view_dayflow_document_search" model="ir.ui.view">
        <field name="name">dayflow.document.search</field>
        <field name="model">dayflow.document</field>
        <field name="arch" type="xml">
            <search string="Search Employee Documents">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="file_name"/>
                <separator/>
                <filter string="Verified Documents" name="status_verified" domain="[('document_status', '=', 'verified')]"/>
                <filter string="Pending Verification" name="status_draft" domain="[('document_status', '=', 'draft')]"/>
                <filter string="Rejected" name="status_rejected" domain="[('document_status', '=', 'rejected')]"/>
                <filter string="Expired" name="status_expired" domain="[('document_status', '=', 'expired')]"/>
                <separator/>
                <filter string="ID Proof" name="type_id_proof" domain="[('document_type', '=', 'id_proof')]"/>
                <filter string="Contract" name="type_contract" domain="[('document_type', '=', 'contract')]"/>
                <filter string="Certificate" name="type_certificate" domain="[('document_type', '=', 'certificate')]"/>
                <filter string="Other" name="type_other" domain="[('document_type', '=', 'other')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Document Type" name="group_by_type" context="{'group_by': 'document_type'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'document_status'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
