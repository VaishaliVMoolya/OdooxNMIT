<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Leave Request Inherited Form View -->
    <record id="hr_leave_view_form_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit.dayflow</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_dayflow_submit" string="Submit for Approval" type="object" class="oe_highlight" attrs="{'invisible': [('dayflow_status', '!=', 'pending')]}"/>
                    <button name="action_dayflow_approve" string="Approve" type="object" class="btn-success" groups="dayflow.group_dayflow_admin" attrs="{'invisible': [('dayflow_status', '=', 'approved')]}"/>
                    <button name="action_dayflow_reject" string="Reject" type="object" class="btn-danger" groups="dayflow.group_dayflow_admin" attrs="{'invisible': [('dayflow_status', '=', 'rejected')]}"/>
                    <button name="action_dayflow_reset_pending" string="Reset to Pending" type="object" groups="dayflow.group_dayflow_admin" attrs="{'invisible': [('dayflow_status', '=', 'pending')]}"/>
                    <field name="dayflow_status" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="dayflow_leave_type"/>
                <field name="attachment_submitted"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="remarks" placeholder="Enter reason for time off request..."/>
                <field name="admin_comments" placeholder="HR / Admin decision notes or comments..."/>
                <field name="approved_by_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Leave Request Inherited Tree View -->
    <record id="hr_leave_view_tree_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.leave.view.tree.inherit.dayflow</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="dayflow_leave_type" widget="badge"/>
                <field name="dayflow_status" widget="badge"
                       decoration-warning="dayflow_status == 'pending'"
                       decoration-success="dayflow_status == 'approved'"
                       decoration-danger="dayflow_status == 'rejected'"/>
                <field name="remarks" optional="show"/>
                <field name="admin_comments" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Leave Request Inherited Search View -->
    <record id="view_hr_leave_search_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.leave.search.inherit.dayflow</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="dayflow_pending" string="Pending Dayflow Approval"
                        domain="[('dayflow_status', '=', 'pending')]"/>
                <filter name="dayflow_approved" string="Approved Dayflow Leaves"
                        domain="[('dayflow_status', '=', 'approved')]"/>
                <filter name="dayflow_rejected" string="Rejected Dayflow Leaves"
                        domain="[('dayflow_status', '=', 'rejected')]"/>
                <separator/>
                <filter name="dayflow_paid" string="Paid Leaves"
                        domain="[('dayflow_leave_type', '=', 'paid')]"/>
                <filter name="dayflow_sick" string="Sick Leaves"
                        domain="[('dayflow_leave_type', '=', 'sick')]"/>
                <filter name="dayflow_unpaid" string="Unpaid Leaves"
                        domain="[('dayflow_leave_type', '=', 'unpaid')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_dayflow_status" string="Dayflow Status"
                            context="{'group_by': 'dayflow_status'}"/>
                    <filter name="group_by_dayflow_leave_type" string="Leave Type"
                            context="{'group_by': 'dayflow_leave_type'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Action: Pending Leave Requests -->
    <record id="action_dayflow_leave_pending" model="ir.actions.act_window">
        <field name="name">Pending Leave Requests</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('dayflow_status', '=', 'pending')]</field>
        <field name="context">{'default_dayflow_status': 'pending'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pending leave requests!
            </p>
            <p>
                All employee leave applications have been reviewed.
            </p>
        </field>
    </record>
</odoo>
