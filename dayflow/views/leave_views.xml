<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Leave Request Inherited Form View -->
    <record id="hr_leave_view_form_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit.dayflow</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="dayflow_leave_type"/>
                <field name="dayflow_status"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="remarks"/>
                <field name="admin_comments"/>
            </xpath>
        </field>
    </record>

    <!-- Leave Request Inherited Tree View -->
    <record id="hr_leave_view_tree_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.leave.view.tree.inherit.dayflow</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="dayflow_leave_type"/>
                <field name="dayflow_status"/>
            </xpath>
        </field>
    </record>
</odoo>
