<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Module Category -->
        <record id="module_category_dayflow" model="ir.module.category">
            <field name="name">Dayflow HRMS</field>
            <field name="description">Access rights and security groups for Dayflow HRMS</field>
            <field name="sequence">20</field>
        </record>

        <!-- Group: Employee -->
        <record id="group_dayflow_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_category_dayflow"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Standard Dayflow employee access: profile, self check-in/out, leave requests, own payroll.</field>
        </record>

        <!-- Group: HR / Admin -->
        <record id="group_dayflow_admin" model="res.groups">
            <field name="name">HR / Admin Manager</field>
            <field name="category_id" ref="module_category_dayflow"/>
            <field name="implied_ids" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="comment">Full Dayflow HR/Admin management access: employee management, leave approvals, payroll setup.</field>
        </record>

        <!-- Record Rules: Payroll -->
        <record id="rule_dayflow_payroll_employee" model="ir.rule">
            <field name="name">Dayflow Payroll: Employee Read Own</field>
            <field name="model_id" ref="model_dayflow_payroll"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_dayflow_payroll_admin" model="ir.rule">
            <field name="name">Dayflow Payroll: Admin Full Access</field>
            <field name="model_id" ref="model_dayflow_payroll"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Record Rules: Documents -->
        <record id="rule_dayflow_document_employee" model="ir.rule">
            <field name="name">Dayflow Document: Employee Access Own</field>
            <field name="model_id" ref="model_dayflow_document"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_dayflow_document_admin" model="ir.rule">
            <field name="name">Dayflow Document: Admin Full Access</field>
            <field name="model_id" ref="model_dayflow_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
