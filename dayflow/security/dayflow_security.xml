<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Module Category -->
        <record id="module_category_dayflow" model="ir.module.category">
            <field name="name">Dayflow HRMS</field>
            <field name="description">Access rights and security groups for Dayflow HRMS</field>
            <field name="sequence">20</field>
        </record>

        <!-- Group: Employee -->
        <record id="group_dayflow_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_category_dayflow"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Standard Dayflow employee access: profile, self check-in/out, leave requests, own payroll.</field>
        </record>

        <!-- Group: HR / Admin -->
        <record id="group_dayflow_admin" model="res.groups">
            <field name="name">HR / Admin Manager</field>
            <field name="category_id" ref="module_category_dayflow"/>
            <field name="implied_ids" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="comment">Full Dayflow HR/Admin management access: employee management, leave approvals, payroll setup.</field>
        </record>

        <!-- ============================================== -->
        <!-- RECORD RULES: ATTENDANCE                       -->
        <!-- ============================================== -->

        <!-- Employee: Only personal attendance records -->
        <record id="rule_attendance_dayflow_employee" model="ir.rule">
            <field name="name">Dayflow Attendance: Employee Personal Records Only</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- HR / Admin: All employee attendance records -->
        <record id="rule_attendance_dayflow_admin" model="ir.rule">
            <field name="name">Dayflow Attendance: HR/Admin Full Organization Records</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================== -->
        <!-- RECORD RULES: TIME OFF / LEAVE REQUESTS        -->
        <!-- ============================================== -->

        <!-- Employee: Only personal leave requests -->
        <record id="rule_leave_dayflow_employee" model="ir.rule">
            <field name="name">Dayflow Leave: Employee Personal Requests Only</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- HR / Admin: All employee leave requests -->
        <record id="rule_leave_dayflow_admin" model="ir.rule">
            <field name="name">Dayflow Leave: HR/Admin Full Organization Requests</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
